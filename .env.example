# Copy to .env and fill in. .env holds the secrets: it is NOT part of the volumes, so copy it
# separately (and securely) when moving the service to another machine.

# GitHub
GITHUB_ORGANIZATION=PROG-GITT-UPM
# Fine-grained token: owner the organization, all repositories, Contents read/write, Metadata read
GITHUB_TOKEN=github_pat_...
# CLASSROOM50_CONFIG_REPO=classroom50

# API: every endpoint except / and /health needs "Authorization: Bearer <this token>"
GRADER_API_TOKEN=change-me-to-a-long-random-string

# PostgreSQL (the database container is created with this password on its first start)
POSTGRES_PASSWORD=change-me-too

# Where the API listens on the host. 127.0.0.1 = only from this machine (use an SSH tunnel);
# 0.0.0.0 = from the network (put HTTPS in front).
GRADER_BIND=127.0.0.1
GRADER_PORT=8000

# Grading
# Submissions graded at the same time, each in its own container
GRADER_WORKERS=2
# Seconds between score writes to Classroom 50
GRADER_SAVE_EVERY=60
# Limits of each grading container
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1
SANDBOX_PROCESSES=128
# LOG_LEVEL=INFO

# Host folders for the data. Relative paths are relative to this folder. scripts/setup.sh
# creates them. POSTGRES_DATA_DIR is the whole state of the service.
POSTGRES_DATA_DIR=./data/postgres
PGADMIN_DATA_DIR=./data/pgadmin
# scripts/backup.sh writes here and keeps the newest BACKUP_KEEP dumps
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# Optional database admin console (docker compose --profile admin up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-as-well
