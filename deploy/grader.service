# systemd service for the always-on grader.
#   sudo cp deploy/grader.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now grader
#   journalctl -u grader -f
[Unit]
Description=Assignment grader (Classroom 50)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=grader
Group=grader
# The grader user must be in the docker group to launch the containers.
SupplementaryGroups=docker
WorkingDirectory=/etc/grader
# GITHUB_TOKEN=... and GRADER_API_TOKEN=..., with mode 600 and owned by grader.
EnvironmentFile=/etc/grader/secrets.env
ExecStart=/opt/grader/venv/bin/grader serve -c /etc/grader/grader.toml
Restart=on-failure
RestartSec=10
# On stop, the grader saves pending scores before exiting.
TimeoutStopSec=60
StateDirectory=grader
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/grader
PrivateTmp=true

[Install]
WantedBy=multi-user.target
